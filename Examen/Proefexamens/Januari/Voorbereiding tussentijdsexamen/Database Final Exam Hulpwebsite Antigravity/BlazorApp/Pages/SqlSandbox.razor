@page "/builder"
@using DatabaseStudyGuide.Services
@inject SqlEngine SqlEngine

<div class="flex h-[calc(100vh-64px)] overflow-hidden bg-[#1e1e1e] text-gray-200 font-sans">
    <!-- Left Pane: Schema Explorer -->
    <div class="w-64 flex-shrink-0 border-r border-[#3e3e42] bg-[#252526] flex flex-col">
        <div class="p-3 border-b border-[#3e3e42] font-semibold text-xs tracking-wide text-gray-400 uppercase">
            Explorer: Tables
        </div>
        <div class="flex-1 overflow-y-auto p-2">
            @foreach (var table in SqlEngine.GetSchema())
            {
                <div class="mb-4">
                    <div class="flex items-center text-sm font-medium text-teal-400 mb-1">
                        <span class="mr-2">📄</span> @table.Name
                    </div>
                    <ul class="pl-6 text-xs text-gray-400 space-y-1">
                        @foreach (var col in table.Columns)
                        {
                            <li class="flex items-center">
                                <span class="w-2 h-2 rounded-full bg-teal-800 mr-2"></span> @col
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>

    <!-- Right Area: Editor and Results (Vertical Split) -->
    <div class="flex-1 flex flex-col min-w-0">
        <!-- Top Pane: SQL Editor -->
        <div class="flex-1 flex flex-col border-b border-[#3e3e42]">
            <div class="flex items-center justify-between px-4 py-2 bg-[#2d2d30] border-b border-[#3e3e42]">
                <span class="text-sm font-medium text-gray-300">SQL Query.sql</span>
                <button @onclick="RunQuery" 
                        class="px-3 py-1 bg-teal-600 hover:bg-teal-500 text-white text-xs font-semibold rounded shadow-sm transition-colors flex items-center">
                    <span class="mr-1">▶</span> Execute
                </button>
            </div>
            <div class="flex-1 relative">
                <textarea @bind="query" 
                          class="w-full h-full bg-[#1e1e1e] text-gray-100 p-4 font-mono text-sm resize-none focus:outline-none"
                          spellcheck="false"
                          placeholder="-- Enter your SQL query here...&#10;SELECT * FROM Tennis.Speler"></textarea>
            </div>
        </div>

        <!-- Bottom Pane: Results -->
        <div class="h-64 flex-shrink-0 flex flex-col bg-[#1e1e1e]">
             <div class="px-4 py-2 bg-[#2d2d30] border-b border-[#3e3e42] border-t border-[#3e3e42] text-xs font-semibold text-gray-400 uppercase">
                Results
            </div>
            <div class="flex-1 overflow-auto p-0">
                @if (result != null)
                {
                    @if (result.IsError)
                    {
                        <div class="p-4 text-red-400 font-mono text-sm">
                            Error: @result.Message
                        </div>
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(result.Message))
                        {
                            <div class="p-2 text-teal-400 text-xs font-mono border-b border-[#3e3e42]">
                                @result.Message
                            </div>
                        }
                        
                        @if (result.Columns.Any())
                        {
                            <table class="w-full text-left border-collapse">
                                <thead class="bg-[#252526] sticky top-0">
                                    <tr>
                                        @foreach (var col in result.Columns)
                                        {
                                            <th class="p-2 text-xs font-medium text-gray-400 border-b border-r border-[#3e3e42] whitespace-nowrap">@col</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody class="font-mono text-xs">
                                    @foreach (var row in result.Rows)
                                    {
                                        <tr class="hover:bg-[#2a2d2e] group">
                                            @foreach (var col in result.Columns)
                                            {
                                                <td class="p-2 text-gray-300 border-b border-r border-[#3e3e42] whitespace-nowrap group-hover:text-white">
                                                    @(row.ContainsKey(col) ? row[col]?.ToString() : "NULL")
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }
                }
                else
                {
                    <div class="p-4 text-gray-500 text-sm italic">
                        Execute a query to see results.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string query = "SELECT * FROM Tennis.Speler";
    private SqlEngine.QueryResult? result;

    private void RunQuery()
    {
        result = SqlEngine.Execute(query);
    }
}
