@page "/quiz-exam"
@using DatabaseStudyGuide.Services
@inject QuizService QuizService

<div class="max-w-4xl mx-auto p-6 text-gray-200">
    @if (isLoading)
    {
        <div class="flex flex-col items-center justify-center p-20">
            <div class="animate-spin rounded-full h-16 w-16 border-b-2 border-teal-500 mb-4"></div>
            <p class="text-gray-400">Loading Exam Questions...</p>
        </div>
    }
    else if (!hasStarted)
    {
        <div class="text-center p-12 bg-[#252526] rounded-xl shadow-lg border border-[#3e3e42]">
            <h1 class="text-4xl font-bold text-teal-400 mb-6">Database Final Exam</h1>
            <p class="text-xl text-gray-300 mb-8 max-w-2xl mx-auto">
                Test your knowledge of SQL, ERD, and NoSQL concepts.
                The exam consists of 20 randomly selected questions from all chapters.
            </p>
            <div class="flex justify-center space-x-4">
                <button @onclick="StartQuiz" 
                        class="px-8 py-4 bg-teal-600 hover:bg-teal-500 text-white font-bold text-lg rounded-lg shadow-lg transition-transform transform hover:scale-105">
                    Start Exam
                </button>
            </div>
            <p class="mt-6 text-sm text-gray-500">Current Question Bank: @QuizService.GetAllQuestions().Count questions</p>
        </div>
    }
    else if (isFinished)
    {
        <div class="text-center p-12 bg-[#252526] rounded-xl shadow-lg border border-[#3e3e42]">
            <h2 class="text-3xl font-bold mb-4 text-white">Exam Completed</h2>
            
            <div class="mb-8">
                <div class="relative pt-1 w-full max-w-md mx-auto">
                     <div class="text-6xl font-bold text-teal-400 mb-2">@score / @activeQuestions.Count</div>
                     <div class="text-lg text-gray-400">Final Score: @(Math.Round((double)score / activeQuestions.Count * 100))%</div>
                </div>
            </div>
            
            <button @onclick="RestartQuiz" 
                    class="px-6 py-3 bg-gray-700 hover:bg-gray-600 text-white font-semibold rounded-lg transition-colors">
                Retake Exam
            </button>
        </div>
    }
    else
    {
        <div class="bg-[#252526] rounded-xl shadow-lg border border-[#3e3e42] overflow-hidden">
            <!-- Header / Progress -->
            <div class="bg-[#2d2d30] p-4 border-b border-[#3e3e42] flex justify-between items-center">
                <span class="text-teal-400 font-bold uppercase tracking-wider text-sm">Question @(currentQuestionIndex + 1) of @activeQuestions.Count</span>
                <span class="text-gray-400 text-xs">@activeQuestions[currentQuestionIndex].Category / @activeQuestions[currentQuestionIndex].Topic</span>
            </div>
            
            <div class="w-full bg-gray-700 h-1">
                <div class="bg-teal-500 h-1 transition-all duration-300" style="width: @(((currentQuestionIndex + 1) * 100) / activeQuestions.Count)%"></div>
            </div>

            <div class="p-8">
                <h3 class="text-2xl font-semibold mb-8 text-white">
                    @activeQuestions[currentQuestionIndex].QuestionText
                </h3>

                <div class="space-y-4">
                    @for (int i = 0; i < activeQuestions[currentQuestionIndex].Options.Count; i++)
                    {
                        var index = i;
                        var isSelected = selectedOptionIndex == index;
                        var isCorrect = activeQuestions[currentQuestionIndex].Correct == index;
                        var showResult = hasAnswered;
                        
                        string btnClass = "w-full text-left p-4 rounded-lg border transition-all duration-200 flex items-center ";
                        
                        if (showResult)
                        {
                            if (isCorrect)
                            {
                                btnClass += "bg-green-900/30 border-green-500 text-green-100";
                            }
                            else if (isSelected && !isCorrect)
                            {
                                btnClass += "bg-red-900/30 border-red-500 text-red-100";
                            }
                            else
                            {
                                btnClass += "bg-[#1e1e1e] border-[#3e3e42] text-gray-400 opacity-50";
                            }
                        }
                        else
                        {
                            if (isSelected) 
                            {
                                btnClass += "bg-teal-900/40 border-teal-500 text-white";
                            }
                            else
                            {
                                btnClass += "bg-[#1e1e1e] border-[#3e3e42] hover:border-teal-400 text-gray-300";
                            }
                        }

                        <button @onclick="() => SelectOption(index)" disabled="@showResult" class="@btnClass">
                            <span class="w-8 h-8 rounded-full border border-current flex items-center justify-center mr-4 text-sm font-bold flex-shrink-0">
                                @((char)('A' + i))
                            </span>
                            @activeQuestions[currentQuestionIndex].Options[i]
                        </button>
                    }
                </div>

                @if (hasAnswered)
                {
                    <div class="mt-8 p-4 bg-gray-800 rounded-lg border border-gray-700">
                        <p class="font-bold mb-1 @(isAnswerCorrect ? "text-green-400" : "text-red-400")">
                            @(isAnswerCorrect ? "Correct!" : "Incorrect.")
                        </p>
                        <p class="text-gray-300 text-sm">@activeQuestions[currentQuestionIndex].Explanation</p>
                    </div>
                    
                    <div class="mt-6 flex justify-end">
                        <button @onclick="NextQuestion" 
                                class="px-6 py-2 bg-teal-600 hover:bg-teal-500 text-white font-bold rounded shadow transition-colors">
                            @(currentQuestionIndex < activeQuestions.Count - 1 ? "Next Question →" : "Finish Exam")
                        </button>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private bool hasStarted = false;
    private bool isFinished = false;
    
    private List<QuizDetail> activeQuestions = new();
    private int currentQuestionIndex = 0;
    private int score = 0;
    
    // UI State for current question
    private int? selectedOptionIndex = null;
    private bool hasAnswered = false;
    private bool isAnswerCorrect = false;

    protected override async Task OnInitializedAsync()
    {
        await QuizService.LoadQuestionsAsync();
        isLoading = false;
    }

    private void StartQuiz()
    {
        activeQuestions = QuizService.GetRandomQuestions(20);
        if (activeQuestions.Count == 0) return; // Should not happen
        
        currentQuestionIndex = 0;
        score = 0;
        ResetQuestionState();
        hasStarted = true;
        isFinished = false;
    }

    private void RestartQuiz()
    {
        StartQuiz();
    }

    private void ResetQuestionState()
    {
        selectedOptionIndex = null;
        hasAnswered = false;
        isAnswerCorrect = false;
    }

    private void SelectOption(int index)
    {
        if (hasAnswered) return;
        
        selectedOptionIndex = index;
        hasAnswered = true;
        
        var currentQ = activeQuestions[currentQuestionIndex];
        isAnswerCorrect = (index == currentQ.Correct);
        
        if (isAnswerCorrect)
        {
            score++;
        }
    }

    private void NextQuestion()
    {
        if (currentQuestionIndex < activeQuestions.Count - 1)
        {
            currentQuestionIndex++;
            ResetQuestionState();
        }
        else
        {
            isFinished = true;
        }
    }
}
