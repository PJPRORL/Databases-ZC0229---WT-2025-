        <mxCell id="lvuOQLqTXdmxh-NX_1fM-133" parent="1" style="shape=note;size=20;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" value="Correcties opdracht&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Entiteit &lt;b&gt;Afdeling&lt;/b&gt;&amp;nbsp;had geen adres nodig, dit word bewaard in een apart Entiteit.&lt;/div&gt;&lt;div&gt;Entiteit &lt;b&gt;Afdelingslocatie&lt;/b&gt;&amp;nbsp;of &lt;b&gt;Locatie&lt;/b&gt;&amp;nbsp;bewaart alles dat nodig is om te weten waar het bedrijf gelegen is en of het gaat om een internationaal of nationaal bedrijf. Volgende&lt;b&gt;&amp;nbsp;Attributen&lt;/b&gt;&amp;nbsp;zijn noodzakelijk.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;&lt;b&gt;code&lt;/b&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;naam&lt;/b&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;omschrijving&lt;/b&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;straat&lt;/b&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;huisnummer&lt;/b&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;plaats&lt;/b&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;postcode&lt;/b&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;land&lt;/b&gt;&lt;/li&gt;&lt;/ol&gt;&lt;div&gt;&lt;b&gt;Attribuut&lt;/b&gt;&amp;nbsp;nummer 8 zorgt er dus voor dat we kunnen aangeven of het gaat om een nationaal of internationaal bedrijf.&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Entiteit&lt;b&gt;&amp;nbsp;Kwalificatie&lt;/b&gt;&amp;nbsp;moest opgedeeld worden in 2 aparte &lt;b&gt;Entiteiten&lt;/b&gt;&amp;nbsp;genaamd, &lt;b&gt;Kwalificatie&lt;/b&gt;&amp;nbsp;en &lt;b&gt;Diploma&lt;/b&gt;.&lt;/div&gt;&lt;div&gt;Entiteit &lt;b&gt;Kwalificatie&lt;/b&gt;&amp;nbsp;krijgt het attribuut &lt;b&gt;afstudeerjaar&lt;/b&gt;.&lt;/div&gt;&lt;div&gt;Enititeit &lt;b&gt;Diploma&lt;/b&gt;&amp;nbsp;krijgt het attribuut &lt;b&gt;jaar&lt;/b&gt;.&lt;/div&gt;" vertex="1">
          <mxGeometry height="327" width="670" x="130" y="492" as="geometry" />
        </mxCell>
